<Window x:Class="shahmati.Views.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Шахматная статистика" 
        Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#f0f2f5"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" Opacity="0.08" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2c3e50"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="BigNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="NumberLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#7f8c8d"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>

        <Style x:Key="BackButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2980B9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1C5A7D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#e0e0e0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="35"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#ecf0f1"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#f8f9fa"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Шапка -->
        <Border Background="#2c3e50" Height="70" VerticalAlignment="Top">
            <Grid Margin="15,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="← Назад" 
                       Click="BackButton_Click"
                       Style="{StaticResource BackButtonStyle}"
                       VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1" Text="📊 Статистика игрока" 
                          Foreground="White" FontSize="20" FontWeight="Bold"
                          VerticalAlignment="Center" HorizontalAlignment="Center"/>

                <!-- Информация пользователя без круга -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                    <StackPanel Margin="8,0,0,0">
                        <TextBlock x:Name="UserNameText" Text="Игрок" 
                                  Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock x:Name="UserRatingText" Text="Рейтинг: 1200" 
                                  Foreground="#bdc3c7" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основной контент -->
        <Grid Margin="0,70,0,0">
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Строка 1: Общая статистика -->
                <Border Grid.Row="0" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="📈 Общая статистика" Style="{StaticResource CardTitle}"/>

                        <Grid Margin="0,5,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="TotalGamesText" Text="0" Style="{StaticResource BigNumber}" Foreground="#3498db"/>
                                <TextBlock Text="Всего игр" Style="{StaticResource NumberLabel}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="WinsText" Text="0" Style="{StaticResource BigNumber}" Foreground="#2ecc71"/>
                                <TextBlock Text="Побед" Style="{StaticResource NumberLabel}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="LossesText" Text="0" Style="{StaticResource BigNumber}" Foreground="#e74c3c"/>
                                <TextBlock Text="Поражений" Style="{StaticResource NumberLabel}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock x:Name="DrawsText" Text="0" Style="{StaticResource BigNumber}" Foreground="#f39c12"/>
                                <TextBlock Text="Ничьих" Style="{StaticResource NumberLabel}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock x:Name="WinRateText" Text="0%" Style="{StaticResource BigNumber}" Foreground="#9b59b6"/>
                                <TextBlock Text="Процент побед" Style="{StaticResource NumberLabel}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Строка 2: Рейтинг и Игры против людей -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Рейтинг и достижения -->
                    <Border Grid.Column="0" Style="{StaticResource StatCard}" Margin="0,0,5,0">
                        <StackPanel>
                            <TextBlock Text="🏆 Рейтинг и достижения" Style="{StaticResource CardTitle}"/>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#f8f9fa" CornerRadius="8" Padding="12" Margin="0,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Текущий рейтинг" FontWeight="SemiBold" Foreground="#7f8c8d"/>
                                        <TextBlock Grid.Column="1" x:Name="CurrentRatingText" Text="1200" 
                                                  FontSize="20" FontWeight="Bold" Foreground="#3498db"/>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1" Background="#f8f9fa" CornerRadius="8" Padding="12" Margin="0,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Лучший рейтинг" FontWeight="SemiBold" Foreground="#7f8c8d"/>
                                        <TextBlock Grid.Column="1" x:Name="BestRatingText" Text="1200" 
                                                  FontSize="20" FontWeight="Bold" Foreground="#2ecc71"/>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="2" Background="#f8f9fa" CornerRadius="8" Padding="12" Margin="0,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Текущая серия побед" FontWeight="SemiBold" Foreground="#7f8c8d"/>
                                        <TextBlock Grid.Column="1" x:Name="CurrentStreakText" Text="0" 
                                                  FontSize="20" FontWeight="Bold" Foreground="#e74c3c"/>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="3" Background="#f8f9fa" CornerRadius="8" Padding="12" Margin="0,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Лучшая серия побед" FontWeight="SemiBold" Foreground="#7f8c8d"/>
                                        <TextBlock Grid.Column="1" x:Name="BestStreakText" Text="0" 
                                                  FontSize="20" FontWeight="Bold" Foreground="#e74c3c"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Игры против людей -->
                    <Border Grid.Column="1" Style="{StaticResource StatCard}" Margin="5,0,0,0">
                        <StackPanel>
                            <TextBlock Text="👥 Игры против людей" Style="{StaticResource CardTitle}"/>

                            <Border Background="#f8f9fa" CornerRadius="8" Padding="12" Margin="0,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Всего игр" FontWeight="SemiBold" Foreground="#7f8c8d"/>
                                    <TextBlock Grid.Column="1" x:Name="VsHumanGamesText" Text="0" 
                                              FontSize="20" FontWeight="Bold" Foreground="#3498db"/>
                                </Grid>
                            </Border>

                            <Border Background="#f8f9fa" CornerRadius="8" Padding="12" Margin="0,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Побед" FontWeight="SemiBold" Foreground="#7f8c8d"/>
                                    <TextBlock Grid.Column="1" x:Name="VsHumanWinsText" Text="0" 
                                              FontSize="20" FontWeight="Bold" Foreground="#2ecc71"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Строка 3: История рейтинга -->
                <Border Grid.Row="2" Style="{StaticResource StatCard}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="📈 История рейтинга (последние 20 игр)" Style="{StaticResource CardTitle}"/>

                        <DataGrid x:Name="RatingHistoryGrid" 
                                 Style="{StaticResource CustomDataGridStyle}"
                                 AutoGenerateColumns="False"
                                 IsReadOnly="True"
                                 HeadersVisibility="Column"
                                 Margin="0,5"
                                 MaxHeight="250">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Дата" Width="130"
                                                   Binding="{Binding CreatedAt, StringFormat='{}{0:dd.MM.yy HH:mm}'}"/>
                                <DataGridTextColumn Header="Игра №" Width="70" Binding="{Binding GameId}"/>
                                <DataGridTextColumn Header="Оппонент" Width="120" Binding="{Binding OpponentName}"/>
                                <DataGridTextColumn Header="Результат" Width="80" Binding="{Binding Result}"/>
                                <DataGridTextColumn Header="Старый рейтинг" Width="100" Binding="{Binding OldRating}"/>
                                <DataGridTextColumn Header="Новый рейтинг" Width="100" Binding="{Binding NewRating}"/>
                                <DataGridTextColumn Header="Изменение" Width="80" 
                                                   Binding="{Binding RatingChange, StringFormat='{}{0:+0;-0;0}'}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Индикатор загрузки -->
        <Border x:Name="LoadingOverlay" Background="#C0000000" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="8" Margin="0,0,0,15"/>
                <TextBlock Text="Загрузка статистики..." Foreground="White" FontSize="14" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>