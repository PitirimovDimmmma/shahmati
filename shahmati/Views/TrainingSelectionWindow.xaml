<Window x:Class="shahmati.Views.TrainingSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:shahmati.Views"
        mc:Ignorable="d"
        Title="Шахматный тренажер - Выбор тренировки" 
        Height="806" Width="1100"  
        WindowStartupLocation="CenterScreen"
        Background="#2C3E50"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize">

    <Window.Resources>
        <!-- Стиль для карточек (как в MainWindow) -->
        <Style x:Key="InfoCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#34495E"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <!-- Стиль для прямоугольных карточек тренировок -->
        <Style x:Key="TrainingCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#34495E"/>
            <Setter Property="Height" Value="140"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="10,8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" Opacity="0.2" ShadowDepth="3"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3C4E60"/>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <TranslateTransform Y="-2"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для панели фильтров -->
        <Style x:Key="FilterPanelStyle" TargetType="Border" BasedOn="{StaticResource InfoCardStyle}">
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <!-- Стиль для тегов сложности -->
        <Style x:Key="DifficultyTagStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Difficulty}" Value="Новичок">
                    <Setter Property="Background" Value="#27AE60"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Difficulty}" Value="Средний">
                    <Setter Property="Background" Value="#3498DB"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Difficulty}" Value="Сложный">
                    <Setter Property="Background" Value="#E74C3C"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Difficulty}" Value="Эксперт">
                    <Setter Property="Background" Value="#9B59B6"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для кнопок управления -->
        <Style x:Key="ControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2980B9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1C5A7D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для кнопки назад -->
        <Style x:Key="BackButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для RadioButton -->
        <Style x:Key="RadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Стиль для CheckBox -->
        <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Стиль для TextBox -->
        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#2C3E50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4A6572"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ШАПКА -->
        <Border Grid.Row="0" Background="#34495E" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- КНОПКА НАЗАД -->
                <Button Grid.Column="0" 
                       Content="← НАЗАД" 
                       Style="{StaticResource BackButtonStyle}"
                       Click="BackButton_Click"/>

                <!-- ЗАГОЛОВОК -->
                <StackPanel Grid.Column="1" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center">
                    <TextBlock Text="ВЫБОР ТРЕНИРОВКИ" 
                              Foreground="White" 
                              FontSize="24" 
                              FontWeight="Bold"
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="Выберите тренировку для улучшения навыков" 
                              Foreground="#BDC3C7" 
                              FontSize="12"
                              HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ОСНОВНАЯ ОБЛАСТЬ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ПАНЕЛЬ ФИЛЬТРОВ -->
            <Border Grid.Column="0" 
                   Background="#34495E" 
                   Margin="0,0,1,0"
                   BorderBrush="#4A6572"
                   BorderThickness="0,1,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>

                        <!-- ПОИСК -->
                        <Border Style="{StaticResource FilterPanelStyle}">
                            <StackPanel>
                                <TextBlock Text="ПОИСК ТРЕНИРОВКИ" 
                                          Foreground="#BDC3C7"
                                          FontSize="12"
                                          FontWeight="Bold"
                                          Margin="0,0,0,8"/>
                                <TextBox x:Name="SearchTextBox" 
                                        Style="{StaticResource SearchTextBoxStyle}"
                                        TextChanged="SearchTextBox_TextChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- КАТЕГОРИИ -->
                        <Border Style="{StaticResource FilterPanelStyle}">
                            <StackPanel>
                                <TextBlock Text="КАТЕГОРИИ" 
                                          Foreground="#BDC3C7"
                                          FontSize="12"
                                          FontWeight="Bold"
                                          Margin="0,0,0,8"/>
                                <RadioButton x:Name="AllCategoryRadio" 
                                           Content="Все категории" 
                                           GroupName="Category"
                                           Style="{StaticResource RadioButtonStyle}"
                                           IsChecked="True"
                                           Checked="CategoryRadio_Checked"/>
                                <RadioButton x:Name="TacticsCategoryRadio" 
                                           Content="Тактика" 
                                           GroupName="Category"
                                           Style="{StaticResource RadioButtonStyle}"
                                           Checked="CategoryRadio_Checked"/>
                                <RadioButton x:Name="OpeningCategoryRadio" 
                                           Content="Дебюты" 
                                           GroupName="Category"
                                           Style="{StaticResource RadioButtonStyle}"
                                           Checked="CategoryRadio_Checked"/>
                                <RadioButton x:Name="EndgameCategoryRadio" 
                                           Content="Эндшпиль" 
                                           GroupName="Category"
                                           Style="{StaticResource RadioButtonStyle}"
                                           Checked="CategoryRadio_Checked"/>
                                <RadioButton x:Name="StrategyCategoryRadio" 
                                           Content="Стратегия" 
                                           GroupName="Category"
                                           Style="{StaticResource RadioButtonStyle}"
                                           Checked="CategoryRadio_Checked"/>
                            </StackPanel>
                        </Border>

                        <!-- СЛОЖНОСТЬ -->
                        <Border Style="{StaticResource FilterPanelStyle}">
                            <StackPanel>
                                <TextBlock Text="СЛОЖНОСТЬ" 
                                          Foreground="#BDC3C7"
                                          FontSize="12"
                                          FontWeight="Bold"
                                          Margin="0,0,0,8"/>
                                <CheckBox x:Name="BeginnerCheckBox" 
                                        Content="Новичок" 
                                        Style="{StaticResource CheckBoxStyle}"
                                        IsChecked="True"
                                        Checked="DifficultyCheckBox_Checked"
                                        Unchecked="DifficultyCheckBox_Checked"/>
                                <CheckBox x:Name="MediumCheckBox" 
                                        Content="Средний" 
                                        Style="{StaticResource CheckBoxStyle}"
                                        IsChecked="True"
                                        Checked="DifficultyCheckBox_Checked"
                                        Unchecked="DifficultyCheckBox_Checked"/>
                                <CheckBox x:Name="HardCheckBox" 
                                        Content="Сложный" 
                                        Style="{StaticResource CheckBoxStyle}"
                                        IsChecked="True"
                                        Checked="DifficultyCheckBox_Checked"
                                        Unchecked="DifficultyCheckBox_Checked"/>
                                <CheckBox x:Name="ExpertCheckBox" 
                                        Content="Эксперт" 
                                        Style="{StaticResource CheckBoxStyle}"
                                        IsChecked="True"
                                        Checked="DifficultyCheckBox_Checked"
                                        Unchecked="DifficultyCheckBox_Checked"/>
                            </StackPanel>
                        </Border>

                        <!-- КНОПКИ УПРАВЛЕНИЯ -->
                        <StackPanel Margin="0,10,0,0">
                            <Button Content="СБРОСИТЬ ФИЛЬТРЫ" 
                                   Style="{StaticResource ControlButtonStyle}"
                                   Background="#E74C3C"
                                   Height="35"
                                   Click="ResetFiltersButton_Click"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- СПИСОК ТРЕНИРОВОК -->
            <ScrollViewer Grid.Column="1" 
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         Padding="20"
                         Background="#2C3E50">

                <ItemsControl x:Name="TrainingsList" 
                            ItemsSource="{Binding FilteredTrainings}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource TrainingCardStyle}"
                                   MouseDown="TrainingCard_MouseDown"
                                   Tag="{Binding Id}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- ИКОНКА -->
                                    <Border Grid.Column="0" 
                                           Width="50" 
                                           Height="50" 
                                           CornerRadius="8"
                                           Background="#3498DB"
                                           VerticalAlignment="Center">
                                        <TextBlock Text="♔" 
                                                  FontSize="24"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Foreground="White"/>
                                    </Border>

                                    <!-- ОСНОВНАЯ ИНФОРМАЦИЯ -->
                                    <StackPanel Grid.Column="1" 
                                               Margin="15,0"
                                               VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" 
                                                  FontSize="16" 
                                                  FontWeight="Bold"
                                                  Foreground="White"
                                                  TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Text="{Binding Description}" 
                                                  FontSize="12"
                                                  Foreground="#BDC3C7"
                                                  TextWrapping="Wrap"
                                                  Margin="0,5,0,0"
                                                  MaxWidth="250"/>

                                        <!-- ТЕГИ -->
                                        <WrapPanel Margin="0,8,0,0">
                                            <Border Style="{StaticResource DifficultyTagStyle}">
                                                <TextBlock Text="{Binding Difficulty}" 
                                                          Foreground="White"
                                                          FontSize="10"
                                                          FontWeight="Bold"/>
                                            </Border>

                                            <Border Background="#8E44AD" 
                                                    CornerRadius="10" 
                                                    Padding="6,3">
                                                <TextBlock Text="{Binding Category}" 
                                                          Foreground="White"
                                                          FontSize="10"
                                                          FontWeight="Bold"/>
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>

                                    <!-- ИНФОРМАЦИЯ СПРАВА -->
                                    <StackPanel Grid.Column="2" 
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" 
                                                   Margin="0,0,0,5">
                                            <TextBlock Text="⏱️"
                                                      FontSize="12"
                                                      Foreground="#FFD700"
                                                      Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding MaxTime, StringFormat={}{0} сек}" 
                                                      FontSize="11"
                                                      Foreground="#BDC3C7"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="♟️"
                                                      FontSize="12"
                                                      Foreground="#FFD700"
                                                      Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding MaxMoves, StringFormat={}{0} ходов}" 
                                                      FontSize="11"
                                                      Foreground="#BDC3C7"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ФУТЕР -->
        <Border Grid.Row="2" 
               Background="#34495E" 
               Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- СТАТУС -->
                <TextBlock Grid.Column="0" 
                          Text="Выберите тренировку кликом мыши" 
                          Foreground="#BDC3C7" 
                          FontSize="12"
                          HorizontalAlignment="Center"/>

                <!-- КОЛИЧЕСТВО -->
                <StackPanel Grid.Column="1" 
                           Orientation="Horizontal">
                    <TextBlock Text="Найдено: " 
                              Foreground="#BDC3C7" 
                              FontSize="12"/>
                    <TextBlock x:Name="FoundCountText" 
                              Text="0" 
                              Foreground="White"
                              FontSize="12"
                              FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>