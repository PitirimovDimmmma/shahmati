<Window x:Class="shahmati.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Шахматный тренажёр - Главная" 
        Height="650" Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#2C3E50">

    <Window.Resources>
        <Style x:Key="MenuCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" Opacity="0.2" ShadowDepth="3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="40"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
        </Style>

        <Style x:Key="CardDescriptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#7F8C8D"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка с информацией пользователя -->
        <Border Grid.Row="0" Background="#34495E" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Шахматный тренажёр" 
                          FontSize="28" FontWeight="Bold" 
                          Foreground="White" 
                          HorizontalAlignment="Left"
                          Margin="182,8,0,21" Grid.Column="1"/>

                <!-- Информация пользователя (без фото) -->
                <Border Grid.Column="0" 
                       Background="Transparent" 
                       Cursor="Hand"
                       MouseDown="UserProfileArea_MouseDown">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="UserNameText" Text="Гость" 
                                      Foreground="White" FontSize="16" FontWeight="Bold"/>
                            <TextBlock x:Name="UserRatingText" Text="Рейтинг: 0" 
                                      Foreground="#BDC3C7" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Кнопка выхода -->
                <Button Grid.Column="2" Content="Выйти" 
                       Background="Transparent" 
                       Foreground="#E74C3C" 
                       BorderThickness="0"
                       FontSize="12"
                       Click="LogoutButton_Click"
                       Padding="10,5"/>
            </Grid>
        </Border>

        <!-- Основное меню -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30" Height="462">

                <!-- Первая строка меню -->
                <UniformGrid Columns="3" Margin="0,0,0,20">
                    <Border Style="{StaticResource MenuCardStyle}" MouseDown="GameCard_MouseDown">
                        <StackPanel>
                            <TextBlock Text="♟" Style="{StaticResource IconStyle}"/>
                            <TextBlock Text="Игра" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="Начать новую шахматную партию" Style="{StaticResource CardDescriptionStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MenuCardStyle}" MouseDown="TrainingCard_MouseDown">
                        <StackPanel>
                            <TextBlock Text="🏋️" Style="{StaticResource IconStyle}"/>
                            <TextBlock Text="Тренировка" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="Упражнения для улучшения навыков" Style="{StaticResource CardDescriptionStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MenuCardStyle}" MouseDown="RulesCard_MouseDown">
                        <StackPanel>
                            <TextBlock Text="📚" Style="{StaticResource IconStyle}"/>
                            <TextBlock Text="Правила" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="Изучить правила шахмат" Style="{StaticResource CardDescriptionStyle}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Вторая строка меню -->
                <UniformGrid Columns="3">
                    <Border Style="{StaticResource MenuCardStyle}" MouseDown="HistoryCard_MouseDown">
                        <StackPanel>
                            <TextBlock Text="📊" Style="{StaticResource IconStyle}"/>
                            <TextBlock Text="История" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="Просмотр истории ваших игр" Style="{StaticResource CardDescriptionStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MenuCardStyle}" MouseDown="StatisticsCard_MouseDown">
                        <StackPanel>
                            <TextBlock Text="📈" Style="{StaticResource IconStyle}"/>
                            <TextBlock Text="Статистика" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="Детальная статистика игрока" Style="{StaticResource CardDescriptionStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MenuCardStyle}" MouseDown="LeaderboardCard_MouseDown">
                        <StackPanel>
                            <TextBlock Text="🏆" Style="{StaticResource IconStyle}"/>
                            <TextBlock Text="Таблица лидеров" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="Рейтинг лучших игроков" Style="{StaticResource CardDescriptionStyle}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>

        <!-- Футер -->
        <Border Grid.Row="2" Background="#34495E" Padding="10">
            <TextBlock Text="Шахматный тренажёр v1.0" 
                      Foreground="#BDC3C7" 
                      HorizontalAlignment="Center" 
                      FontSize="10"/>
        </Border>
    </Grid>
</Window>