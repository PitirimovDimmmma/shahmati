<Window x:Class="shahmati.Views.TrainingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:shahmati.Views"
        xmlns:converters="clr-namespace:shahmati.Converters"
        mc:Ignorable="d"
        Title="Шахматный тренажер - Тренировка" 
        Height="806" Width="1100"  
        WindowStartupLocation="CenterScreen"
        Background="#2C3E50"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Конвертер для путей к изображениям -->
        <converters:ImagePathConverter x:Key="ImagePathConverter"/>

        <!-- Стиль для клеток доски -->
        <Style x:Key="TrainingBoardCellStyle" TargetType="Border">
            <Setter Property="Background" Value="{Binding BackgroundColor}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="LightGreen"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPossibleMove}" Value="True">
                    <Setter Property="Background" Value="#9060EE60"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для карточек -->
        <Style x:Key="TrainingInfoCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#34495E"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <!-- Стиль для статистики -->
        <Style x:Key="TrainingStatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#34495E"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Width" Value="120"/>
        </Style>

        <!-- Стиль для кнопок управления -->
        <Style x:Key="TrainingControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2980B9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1C5A7D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для прогресс бара -->
        <Style x:Key="TrainingProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Background" Value="#2C3E50"/>
            <Setter Property="Foreground" Value="#27AE60"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5">
                            <Grid x:Name="PART_Track">
                                <Rectangle x:Name="PART_Indicator" 
                                           Fill="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Left"
                                           RadiusX="5" RadiusY="5"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ШАПКА -->
        <Border Grid.Row="0" Background="#34495E" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Кнопка назад -->
                <Button Grid.Column="0" 
                        Content="← НАЗАД" 
                        Background="Transparent"
                        Foreground="#BDC3C7"
                        BorderThickness="0"
                        FontSize="12"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="BackButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" 
                                                Padding="15,8">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- СТАТИСТИКА -->
                <StackPanel Grid.Column="1" 
                           HorizontalAlignment="Center" 
                           Orientation="Horizontal">

                    <!-- ТЕКУЩИЙ ИГРОК -->
                    <Border Style="{StaticResource TrainingStatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="ХОД" 
                                      Foreground="#BDC3C7" 
                                      FontSize="10"/>
                            <TextBlock x:Name="CurrentPlayerText" 
                                      Text="БЕЛЫЕ" 
                                      Foreground="#3498DB" 
                                      FontSize="18" 
                                      FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- ОЧКИ -->
                    <Border Style="{StaticResource TrainingStatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="ОЧКИ" 
                                      Foreground="#BDC3C7" 
                                      FontSize="10"/>
                            <TextBlock x:Name="ScoreText" 
                                      Text="0" 
                                      Foreground="#FFD700" 
                                      FontSize="18" 
                                      FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- ВРЕМЯ -->
                    <Border Style="{StaticResource TrainingStatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="ВРЕМЯ" 
                                      Foreground="#BDC3C7" 
                                      FontSize="10"/>
                            <TextBlock x:Name="TimerText" 
                                      Text="00:00" 
                                      Foreground="White" 
                                      FontSize="18" 
                                      FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- ОШИБКИ -->
                    <Border Style="{StaticResource TrainingStatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="ОШИБКИ" 
                                      Foreground="#BDC3C7" 
                                      FontSize="10"/>
                            <TextBlock x:Name="MistakesText" 
                                      Text="0" 
                                      Foreground="#E74C3C" 
                                      FontSize="18" 
                                      FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- ПРОГРЕСС -->
                    <Border Style="{StaticResource TrainingStatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="ПРОГРЕСС" 
                                      Foreground="#BDC3C7" 
                                      FontSize="10"/>
                            <TextBlock x:Name="ProgressText" 
                                      Text="0/10" 
                                      Foreground="#27AE60" 
                                      FontSize="18" 
                                      FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- КНОПКИ УПРАВЛЕНИЯ -->
                <StackPanel Grid.Column="2" 
                           Orientation="Horizontal">
                    <Button x:Name="HintButton" 
                           Content="💡 ПОДСКАЗКА" 
                           Style="{StaticResource TrainingControlButtonStyle}"
                           Background="#27AE60"
                           Margin="0,0,10,0"
                           Click="HintButton_Click"/>
                    <Button x:Name="SolutionButton" 
                           Content="👁️ РЕШЕНИЕ" 
                           Style="{StaticResource TrainingControlButtonStyle}"
                           Background="#F39C12"
                           Click="ShowSolutionButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основная область -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- ШАХМАТНАЯ ДОСКА -->
            <Viewbox Grid.Column="0" Stretch="Uniform" Margin="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Background="#2C2C2C" CornerRadius="5" BorderBrush="#2C2C2C" BorderThickness="3" Padding="15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="25"/>
                            <ColumnDefinition Width="480"/>
                            <ColumnDefinition Width="25"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="480"/>
                            <RowDefinition Height="25"/>
                        </Grid.RowDefinitions>

                        <!-- САМА ДОСКА С КЛЕТКАМИ -->
                        <Border Grid.Row="1" Grid.Column="1" Background="#2C2C2C">
                            <ItemsControl ItemsSource="{Binding Board.CellsFlat}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="8" Columns="8"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="60" Height="60" 
                                               BorderBrush="Transparent" BorderThickness="0"
                                               Style="{StaticResource TrainingBoardCellStyle}">

                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" 
                                                             Command="{Binding DataContext.CellClickCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                             CommandParameter="{Binding Position}"/>
                                            </Border.InputBindings>

                                            <!-- ВОЗВРАЩАЕМ КОНВЕРТЕР -->
                                            <Image Source="{Binding Piece.ImagePath, Converter={StaticResource ImagePathConverter}}" 
                                                   Width="45" Height="45"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- ЦИФРЫ СЛЕВА -->
                        <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Height="480">
                            <TextBlock Text="8" Foreground="#E8E8E8" FontWeight="SemiBold" FontSize="14" FontFamily="Arial" Margin="0,0,0,60"/>
                            <TextBlock Text="7" Foreground="#E8E8E8" FontWeight="SemiBold" FontSize="14" FontFamily="Arial" Margin="0,0,0,60"/>
                            <TextBlock Text="6" Foreground="#E8E8E8" FontWeight="SemiBold" FontSize="14" FontFamily="Arial" Margin="0,0,0,60"/>
                            <TextBlock Text="5" Foreground="#E8E8E8" FontWeight="SemiBold" FontSize="14" FontFamily="Arial" Margin="0,0,0,60"/>
                            <TextBlock Text="4" Foreground="#E8E8E8" FontWeight="SemiBold" FontSize="14" FontFamily="Arial" Margin="0,0,0,60"/>
                            <TextBlock Text="3" Foreground="#E8E8E8" FontWeight="SemiBold" FontSize="14" FontFamily="Arial" Margin="0,0,0,60"/>
                            <TextBlock Text="2" Foreground="#E8E8E8" FontWeight="SemiBold" FontSize="14" FontFamily="Arial" Margin="0,0,0,60"/>
                            <TextBlock Text="1" Foreground="#E8E8E8" FontWeight="SemiBold" FontSize="14" FontFamily="Arial"/>
                        </StackPanel>

                        <!-- ЦИФРЫ СПРАВА -->
                        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Height="480">
                            <TextBlock Text="8" Foreground="#E8E8E8" FontWeight="SemiBold" FontSize="14" FontFamily="Arial" Margin="0,0,0,60"/>
                            <TextBlock Text="7" Foreground="#E8E8E8" FontWeight="SemiBold" FontSize="14" FontFamily="Arial" Margin="0,0,0,60"/>
                            <TextBlock Text="6" Foreground="#E8E8E8" FontWeight="SemiBold" FontSize="14" FontFamily="Arial" Margin="0,0,0,60"/>
                            <TextBlock Text="5" Foreground="#E8E8E8" FontWeight="SemiBold" FontSize="14" FontFamily="Arial" Margin="0,0,0,60"/>
                            <TextBlock Text="4" Foreground="#E8E8E8" FontWeight="SemiBold" FontSize="14" FontFamily="Arial" Margin="0,0,0,60"/>
                            <TextBlock Text="3" Foreground="#E8E8E8" FontWeight="SemiBold" FontSize="14" FontFamily="Arial" Margin="0,0,0,60"/>
                            <TextBlock Text="2" Foreground="#E8E8E8" FontWeight="SemiBold" FontSize="14" FontFamily="Arial" Margin="0,0,0,60"/>
                            <TextBlock Text="1" Foreground="#E8E8E8" FontWeight="SemiBold" FontSize="14" FontFamily="Arial"/>
                        </StackPanel>

                        <!-- БУКВЫ СВЕРХУ -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="a" Foreground="#E8E8E8" FontWeight="SemiBold" FontSize="14" FontFamily="Arial" Margin="30,0,60,0"/>
                            <TextBlock Text="b" Foreground="#E8E8E8" FontWeight="SemiBold" FontSize="14" FontFamily="Arial" Margin="0,0,60,0"/>
                            <TextBlock Text="c" Foreground="#E8E8E8" FontWeight="SemiBold" FontSize="14" FontFamily="Arial" Margin="0,0,60,0"/>
                            <TextBlock Text="d" Foreground="#E8E8E8" FontWeight="SemiBold" FontSize="14" FontFamily="Arial" Margin="0,0,60,0"/>
                            <TextBlock Text="e" Foreground="#E8E8E8" FontWeight="SemiBold" FontSize="14" FontFamily="Arial" Margin="0,0,60,0"/>
                            <TextBlock Text="f" Foreground="#E8E8E8" FontWeight="SemiBold" FontSize="14" FontFamily="Arial" Margin="0,0,60,0"/>
                            <TextBlock Text="g" Foreground="#E8E8E8" FontWeight="SemiBold" FontSize="14" FontFamily="Arial" Margin="0,0,60,0"/>
                            <TextBlock Text="h" Foreground="#E8E8E8" FontWeight="SemiBold" FontSize="14" FontFamily="Arial"/>
                        </StackPanel>

                        <!-- БУКВЫ СНИЗУ -->
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="a" Foreground="#E8E8E8" FontWeight="SemiBold" FontSize="14" FontFamily="Arial" Margin="30,0,60,0"/>
                            <TextBlock Text="b" Foreground="#E8E8E8" FontWeight="SemiBold" FontSize="14" FontFamily="Arial" Margin="0,0,60,0"/>
                            <TextBlock Text="c" Foreground="#E8E8E8" FontWeight="SemiBold" FontSize="14" FontFamily="Arial" Margin="0,0,60,0"/>
                            <TextBlock Text="d" Foreground="#E8E8E8" FontWeight="SemiBold" FontSize="14" FontFamily="Arial" Margin="0,0,60,0"/>
                            <TextBlock Text="e" Foreground="#E8E8E8" FontWeight="SemiBold" FontSize="14" FontFamily="Arial" Margin="0,0,60,0"/>
                            <TextBlock Text="f" Foreground="#E8E8E8" FontWeight="SemiBold" FontSize="14" FontFamily="Arial" Margin="0,0,60,0"/>
                            <TextBlock Text="g" Foreground="#E8E8E8" FontWeight="SemiBold" FontSize="14" FontFamily="Arial" Margin="0,0,60,0"/>
                            <TextBlock Text="h" Foreground="#E8E8E8" FontWeight="SemiBold" FontSize="14" FontFamily="Arial"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Viewbox>

            <!-- ПАНЕЛЬ ТРЕНИРОВКИ -->
            <Border Grid.Column="1" 
                   Background="#F5F5DC" 
                   Margin="10" 
                   CornerRadius="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">

                        <!-- ТЕКУЩАЯ ПОЗИЦИЯ -->
                        <Border Style="{StaticResource TrainingInfoCardStyle}" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="ТЕКУЩАЯ ПОЗИЦИЯ" 
                                          FontSize="12" 
                                          Foreground="#BDC3C7"
                                          FontWeight="Bold"/>
                                <TextBlock x:Name="PositionTitleText" 
                                          Text="ПОЗИЦИЯ #1" 
                                          FontSize="22" 
                                          FontWeight="Bold"
                                          Foreground="#FFD700"
                                          Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- ЗАДАНИЕ -->
                        <Border Style="{StaticResource TrainingInfoCardStyle}" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="ЗАДАНИЕ" 
                                          FontSize="12" 
                                          Foreground="#BDC3C7"
                                          FontWeight="Bold"
                                          Margin="0,0,0,8"/>
                                <TextBlock x:Name="PositionTaskText" 
                                          Text="Найдите лучший ход в данной позиции"
                                          FontSize="14"
                                          Foreground="White"
                                          TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- ПРОГРЕСС ТРЕНИРОВКИ -->
                        <Border Style="{StaticResource TrainingInfoCardStyle}" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="ПРОГРЕСС ТРЕНИРОВКИ" 
                                          FontSize="12" 
                                          Foreground="#BDC3C7"
                                          FontWeight="Bold"
                                          Margin="0,0,0,12"/>

                                <ProgressBar x:Name="TrainingProgressBar" 
                                            Value="0" Maximum="10"
                                            Style="{StaticResource TrainingProgressBarStyle}"/>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" 
                                              Text="{Binding ElementName=TrainingProgressBar, Path=Value, StringFormat={}{0}%}" 
                                              FontSize="11"
                                              Foreground="#BDC3C7"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- УПРАВЛЕНИЕ ТРЕНИРОВКОЙ -->
                        <Border Style="{StaticResource TrainingInfoCardStyle}" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="УПРАВЛЕНИЕ" 
                                          FontSize="12" 
                                          Foreground="#BDC3C7"
                                          FontWeight="Bold"
                                          Margin="0,0,0,12"/>

                                <Button x:Name="NextButton" 
                                       Content="➡️ СЛЕДУЮЩАЯ ПОЗИЦИЯ" 
                                       Height="42"
                                       Style="{StaticResource TrainingControlButtonStyle}"
                                       Background="#27AE60"
                                       FontSize="13"
                                       Click="NextButton_Click"
                                       Margin="0,0,0,8"/>

                                <Button x:Name="ShowSolutionButton" 
                                       Content="👁️ ПОКАЗАТЬ РЕШЕНИЕ" 
                                       Height="42"
                                       Style="{StaticResource TrainingControlButtonStyle}"
                                       Background="#F39C12"
                                       FontSize="13"
                                       Margin="0,0,0,8"
                                       Click="ShowSolutionButton_Click"/>

                                <Button x:Name="CompleteTrainingButton" 
                                       Content="🏁 ЗАВЕРШИТЬ ТРЕНИРОВКУ" 
                                       Height="42"
                                       Style="{StaticResource TrainingControlButtonStyle}"
                                       Background="#E74C3C"
                                       FontSize="13"
                                       Click="CompleteButton_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- ПОДСКАЗКА -->
                        <Border Style="{StaticResource TrainingInfoCardStyle}">
                            <StackPanel>
                                <TextBlock Text="ПОДСКАЗКА" 
                                          FontSize="12" 
                                          Foreground="#BDC3C7"
                                          FontWeight="Bold"
                                          Margin="0,0,0,8"/>

                                <Border Height="100" 
                                       CornerRadius="8"
                                       Background="#2C3E50"
                                       Padding="10">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <TextBlock x:Name="HintTextBlock" 
                                                  Text="Нажмите на фигуру текущего игрока, чтобы увидеть возможные ходы"
                                                  FontSize="12"
                                                  Foreground="#ECF0F1"
                                                  TextWrapping="Wrap"/>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Футер со статусом -->
        <Border Grid.Row="2" 
               Background="#34495E" 
               Padding="12">
            <StackPanel Orientation="Horizontal" 
                       HorizontalAlignment="Center">
                <TextBlock Text="♜" 
                          Foreground="White" 
                          FontSize="14"
                          Margin="0,0,8,0"/>
                <TextBlock x:Name="StatusText" 
                          Text="Тренировка начата. Найдите лучший ход на доске." 
                          Foreground="#BDC3C7" 
                          FontSize="12"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>